{
  "manifest_version": 3,
  "name": "PSX Pulse",
  "version": "1.0",
  "description": "Shows live KSE-100 points and track your favorite stocks.",
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "PSX Pulse.png"
  },
  "icons": {
    "16": "PSX Pulse.png",
    "48": "PSX Pulse.png",
    "128": "PSX Pulse.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
