{
  "manifest_version": 3,
  "name": "KSE Stock Tracker",
  "version": "1.0",
  "permissions": [
    "storage",
    "notifications",
    "https://dps.psx.com.pk/*" 
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://dps.psx.com.pk/*" 
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
